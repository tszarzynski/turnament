    "run:ios": "cap run ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "turnament-web": "workspace:"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0"
  }
}
